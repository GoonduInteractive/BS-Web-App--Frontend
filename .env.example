# Copy to .env and fill in. .env is never committed; this template is.
# Optional settings stay commented out until set: an empty value is not the same as unset.

# The Beyond Service API. Required: the site has no other data, and won't start without it.
NEXT_PUBLIC_API_URL=https://backend-a5um.onrender.com

# Where the site is deployed, no trailing slash. Canonicals, cards and the sitemap are built on it.
# Unset: the Vercel production URL on Vercel, else http://localhost:3000.
# NEXT_PUBLIC_SITE_URL=https://example.com

# The header REGISTER form's Google Apps Script /exec URL (scripts/register-sheet/README.md).
# Unset: the form says the send failed.
# NEXT_PUBLIC_REGISTER_ENDPOINT=

# The Active Player Map's MapLibre style URL. Unset: OpenFreeMap's dark style, which needs no key.
# NEXT_PUBLIC_MAP_STYLE=

# Local only: Igbo machine translation (npm run translate). A key restricted to the Cloud Translation API.
# GOOGLE_TRANSLATE_API_KEY=
